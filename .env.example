# OCR is always enabled; select the backend
OCR_ENGINE=paddleocr
OCR_LANGUAGES=en,hi
OCR_MAX_CONCURRENT_REQUESTS=1

# Required for every endpoint except / and /health (minimum 32 characters)
API_KEY=replace-with-a-strong-key-at-least-32-characters

# Reserved for upcoming local LLM support; keep disabled
ENABLE_LLM=false

# Reserved local LLM settings
LLM_BACKEND=llama_cpp
LLM_MODEL_PATH=./models/model.gguf
LLM_DEVICE=cpu

# Processing limits
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=50
MAX_IMAGE_PIXELS=25000000
